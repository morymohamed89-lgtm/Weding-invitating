<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>دعوة زفاف</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Tahoma', sans-serif;
}

body{
background:linear-gradient(135deg,#fff8f0,#f7e7ce);
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
padding:20px;
}

.card{
max-width:700px;
width:100%;
background:white;
padding:40px;
border-radius:25px;
box-shadow:0 10px 30px rgba(0,0,0,.15);
text-align:center;
}

h1{
color:#b8860b;
font-size:42px;
margin-bottom:15px;
}

.names{
font-size:34px;
font-weight:bold;
color:#8b4513;
margin:20px 0;
}

.date{
font-size:22px;
margin-bottom:25px;
}

.message{
font-size:20px;
line-height:1.8;
margin-bottom:30px;
color:#444;
}

.countdown{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:15px;
margin:30px 0;
}

.box{
background:#b8860b;
color:white;
padding:15px;
border-radius:15px;
width:100px;
}

.box span{
display:block;
font-size:30px;
font-weight:bold;
}

.buttons{
margin-top:25px;
display:flex;
justify-content:center;
gap:15px;
flex-wrap:wrap;
}

.btn{
text-decoration:none;
padding:14px 25px;
border-radius:10px;
color:white;
font-size:18px;
transition:0.3s;
}

.rsvp{
background:#28a745;
}

.location{
background:#007bff;
}

.btn:hover{
opacity:.85;
}
</style>
</head>

<body>

<div class="card">

<h1>💍 دعوة زفاف</h1>

<div class="names">
مريم & أحمد
</div>

<div class="message">
يسعدنا ويشرفنا حضوركم معنا ومشاركتنا أجمل لحظات العمر
</div>

<div class="date">
📅 الجمعة 15 مايو 2027
</div>

<div class="countdown">

<div class="box">
<span id="days">0</span>
يوم
</div>

<div class="box">
<span id="hours">0</span>
ساعة
</div>

<div class="box">
<span id="minutes">0</span>
دقيقة
</div>

<div class="box">
<span id="seconds">0</span>
ثانية
</div>

</div>

<div class="buttons">

<a class="btn rsvp"
href="https://wa.me/201000000000">
تأكيد الحضور
</a>

<a class="btn location"
href="https://maps.google.com"
target="_blank">
موقع القاعة
</a>

</div>

</div>

<script>

const weddingDate =
new Date("May 15, 2027 20:00:00").getTime();

setInterval(function(){

const now = new Date().getTime();

const distance = weddingDate - now;

const days =
Math.floor(distance/(1000*60*60*24));

const hours =
Math.floor((distance%(1000*60*60*24))
/(1000*60*60));

const minutes =
Math.floor((distance%(1000*60*60))
/(1000*60));

const seconds =
Math.floor((distance%(1000*60))
/1000);

document.getElementById("days").innerHTML=days;
document.getElementById("hours").innerHTML=hours;
document.getElementById("minutes").innerHTML=minutes;
document.getElementById("seconds").innerHTML=seconds;

},1000);

</script>

</body>
</html>
